.env
/backend/coverage
/.claude

# Documentation (local only)
/documentation/
CLAUDE.md

# Security: Don't commit secrets
values-secrets.yaml
*-secrets.yaml
*.secrets.yaml
values-local-*.yaml
.secrets/

# Environment-specific secret files
/k8s/secrets/secret-prod.yaml
/k8s/secrets/secret-staging.yaml
/helm/realworld/values-staging.yaml
/helm/realworld/values-local-secrets.yaml

# Monitoring secrets
/helm/monitoring/values-local-secrets.yaml
/helm/monitoring/*-secrets.yaml

# Generated credential files
*.key
*.pem
*.crt
.vault-token
# Local kubeconfig files (sensitive!)
kubeconfig*.yaml
kubeconfig*.txt
